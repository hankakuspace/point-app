{% comment %}
  // extensions/pointman-cart/blocks/pointman-cart.liquid
  Point MAN cart points block.
  This block loads the Point MAN App Proxy panel on cart pages.
{% endcomment %}

{% liquid
  assign pointman_max_width = '70rem'

  if block.settings.block_width == 'narrow'
    assign pointman_max_width = '60rem'
  elsif block.settings.block_width == 'standard'
    assign pointman_max_width = '70rem'
  elsif block.settings.block_width == 'wide'
    assign pointman_max_width = '90rem'
  elsif block.settings.block_width == 'full'
    assign pointman_max_width = '100%'
  endif
%}

<style>
  .pointman-cart-block {
    width: 100%;
    max-width: {{ pointman_max_width }};
    margin-top: {{ block.settings.margin_top }}px;
    margin-right: auto;
    margin-bottom: {{ block.settings.margin_bottom }}px;
    margin-left: auto;
    box-sizing: border-box;
  }

  .pointman-cart-block * {
    box-sizing: border-box;
  }

  @media screen and (max-width: 749px) {
    .pointman-cart-block {
      max-width: 100%;
      margin-top: {{ block.settings.mobile_margin_top }}px;
      margin-bottom: {{ block.settings.mobile_margin_bottom }}px;
    }
  }
</style>

{% if customer %}
  <div class="pointman-cart-block">
    <div
      id="pointman-cart-points"
      data-pointman-customer-id="{{ customer.id }}"
      data-pointman-product-ids="{% for item in cart.items %}{{ item.product_id }}{% unless forloop.last %},{% endunless %}{% endfor %}"
    >
      <div style="border:1px solid #dfe3e8;border-radius:12px;padding:14px;background:#fff;">
        <p style="margin:0;font-size:14px;">ポイント情報を読み込んでいます。</p>
      </div>
    </div>
  </div>

  <script>
    (function () {
      var root = document.getElementById("pointman-cart-points");

      if (!root) {
        return;
      }

      var customerId = root.getAttribute("data-pointman-customer-id") || "";
      var productIds = root.getAttribute("data-pointman-product-ids") || "";

      if (!customerId) {
        return;
      }

      var url =
        "/apps/apps/api/cart-points" +
        "?logged_in_customer_id=" + encodeURIComponent(customerId) +
        "&cartProductIds=" + encodeURIComponent(productIds);

      fetch(url, {
        credentials: "same-origin"
      })
        .then(function (response) {
          return response.text();
        })
        .then(function (html) {
          root.innerHTML = html;
        })
        .catch(function () {
          root.innerHTML =
            '<div style="border:1px solid #fecaca;border-radius:12px;padding:14px;background:#fff7f7;">' +
            '<p style="margin:0;color:#8e1f0b;font-size:14px;font-weight:700;">ポイント情報を読み込めませんでした。</p>' +
            '</div>';
        });
    })();
  </script>
{% else %}
  <div class="pointman-cart-block">
    <div style="border:1px solid #dfe3e8;border-radius:12px;padding:14px;background:#fff;">
      <p style="margin:0;font-size:14px;">ポイントを利用するにはログインが必要です。</p>
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Point MAN points",
  "target": "section",
  "templates": ["cart"],
  "settings": [
    {
      "type": "select",
      "id": "block_width",
      "label": "表示幅",
      "default": "standard",
      "options": [
        {
          "value": "narrow",
          "label": "狭め"
        },
        {
          "value": "standard",
          "label": "標準"
        },
        {
          "value": "wide",
          "label": "広め"
        },
        {
          "value": "full",
          "label": "画面幅いっぱい"
        }
      ]
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "上の余白",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "下の余白",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_margin_top",
      "label": "スマホ上の余白",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "mobile_margin_bottom",
      "label": "スマホ下の余白",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ]
}
{% endschema %}
