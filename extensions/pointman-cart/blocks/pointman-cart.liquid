{% comment %}
  Point MAN cart points block.
  This block loads the Point MAN App Proxy panel on cart pages.
{% endcomment %}

{% if customer %}
  <div
    id="pointman-cart-points"
    data-pointman-customer-id="{{ customer.id }}"
    data-pointman-product-ids="{% for item in cart.items %}{{ item.product_id }}{% unless forloop.last %},{% endunless %}{% endfor %}"
  >
    <div style="border:1px solid #dfe3e8;border-radius:12px;padding:14px;background:#fff;">
      <p style="margin:0;font-size:14px;">ポイント情報を読み込んでいます。</p>
    </div>
  </div>

  <script>
    (function () {
      var root = document.getElementById("pointman-cart-points");

      if (!root) {
        return;
      }

      var customerId = root.getAttribute("data-pointman-customer-id") || "";
      var productIds = root.getAttribute("data-pointman-product-ids") || "";

      if (!customerId) {
        return;
      }

      var url =
        "/apps/apps/api/cart-points" +
        "?logged_in_customer_id=" + encodeURIComponent(customerId) +
        "&cartProductIds=" + encodeURIComponent(productIds);

      fetch(url, {
        credentials: "same-origin"
      })
        .then(function (response) {
          return response.text();
        })
        .then(function (html) {
          root.innerHTML = html;
        })
        .catch(function () {
          root.innerHTML =
            '<div style="border:1px solid #fecaca;border-radius:12px;padding:14px;background:#fff7f7;">' +
            '<p style="margin:0;color:#8e1f0b;font-size:14px;font-weight:700;">ポイント情報を読み込めませんでした。</p>' +
            '</div>';
        });
    })();
  </script>
{% else %}
  <div style="border:1px solid #dfe3e8;border-radius:12px;padding:14px;background:#fff;">
    <p style="margin:0;font-size:14px;">ポイントを利用するにはログインが必要です。</p>
  </div>
{% endif %}

{% schema %}
{
  "name": "Point MAN points",
  "target": "section",
  "templates": ["cart"],
  "settings": []
}
{% endschema %}
